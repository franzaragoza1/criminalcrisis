# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# Public URLs used to build links inside promo emails. Must be the real
# production URLs — a wrong value here means dead links in 350 inboxes.
SITE_URL=https://criminalcrisis.com
PUBLIC_API_URL=https://criminalcrisis.onrender.com

# Postgres. Locally you can point this at Neon too; SSL is enabled automatically
# for anything that isn't localhost.
DATABASE_URL=postgresql://user:password@host/dbname

# No fallback in production: with 350 contacts' personal data behind it, a
# guessable secret is not acceptable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-secret-in-production

# ── Contact form (existing) ──────────────────────────────────────────────────
CONTACT_EMAIL=info@criminalcrisis.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ── Promo pool ───────────────────────────────────────────────────────────────
# resend.com → API Keys. The sending domain must have SPF, DKIM and DMARC set up
# in DNS or promos will keep landing in spam.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=whsec_...
# Gmail reads the From address itself: promos@ / news@ / noreply@ / marketing@
# all push toward the Promotions tab. Use a person's address and a person's
# name. The mailbox need not exist — the domain is DKIM-signed and replies go
# to PROMO_REPLY_TO.
PROMO_FROM_EMAIL=fran@criminalcrisis.com
PROMO_FROM_NAME=Fran — Criminal Crisis
PROMO_REPLY_TO=info@criminalcrisis.com

# Emails sent per day. Resend's free plan allows 100/day, which also happens to
# be a sane warm-up rate for a new sending domain. Raise it only once the domain
# has a track record (and a paid plan).
PROMO_DAILY_CAP=100

# Shared secret for POST /api/promo/queue/drain, called by the hourly GitHub
# Action. Must match the PROMO_CRON_SECRET repository secret.
PROMO_CRON_SECRET=

# ── Media ────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shop ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTFUL_API_KEY=
