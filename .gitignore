node_modules/
client/node_modules/
server/node_modules/
client/dist/
server/dist/
*.db
# Any .env variant, including backups like .env.bak that a stray `git add -A`
# would otherwise sweep into a public repo. The .example files stay tracked.
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example
server/uploads/*
!server/uploads/.gitkeep
.claude/
.vscode/
client/public/img/logo3d.mov

# Contact lists. This repo is public — a promo CSV committed here would expose
# every recipient's address permanently, and git history is not easy to scrub.
# Import them through /admin instead.
*.csv
